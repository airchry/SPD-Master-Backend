<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        @media print {
        .header {
            display: table;
            width: 100%;
        }
        }

        @page {
        size: A4;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10px;
        }

        h1 {
            font-size: 12px;
            text-align: center;
            text-decoration: underline;
            text-decoration-thickness: 2px;
            text-underline-offset: 3px;
        }

        .header {
            display: flex;
            justify-content: center;
        }

        .page {
            page-break-after: auto;
            padding-top: 2px;
        }

        .page-break {
            page-break-before: always;
        }

        .kop-surat {
            text-align: center;
            margin: 0 200px 0 0;
            font-weight: bold;
            line-height: 1.5;
            
        }

        .key-surat {
            margin: 0 10px 0 0;
        }

        table {
            width: 100%;
            margin: 0 auto;
            border: 2px solid black;
        }

        table, td {
            border-collapse: collapse;
        }

        tr, td {
            page-break-inside: avoid;
        }

        td {
            width: 50%;
            vertical-align: top;
            border: 1px solid black;
            padding: 5px;
        }

        .lasttd {
            padding-bottom: 10px;
        }

        .cell-long {
            text-align: justify;
            line-height: 1.4;
        }

        .ppk {
            display: flex;
        }

        .signature {
            padding-top: 120px;
            text-align: center;
        }

    </style>
</head>
<body>

    <div class="page">

        <div class="header">
            <div class="kop-surat">
                <p>KEMENTERIAN KEUANGAN REPUBLIK INDONESIA<br>
                DIREKTORAT JENDERAL PAJAK<br>
                KANWIL DJP JAKARTA BARAT<br>
                KPP PRATAMA JAKARTA TAMANSARI</p>
            </div>

            <div class="key-surat">
                <p>Lembar Ke</p>
                <p>Kode No.</p>
                <p>Nomor</p>
            </div>

            <div class="value-surat">
                <p>: ......................................................................</p>
                <p>: ......................................................................</p>
                <p>: ......................................................................</p>
            </div>
        </div>

        <h1>SURAT PERJALANAN DINAS (SPD)</h1>

