            </tr>
            <tr>
                <td style="border: none"><span style="color: white">7. </span>c. Tanggal harus kembali</td>
                <td style="border-bottom: none; border-top: none" class="lasttd">c. <%= spdFormatted.tanggal_kembali %></td>
            </tr>
            <!-------------------------------------------------------------------------------->

            <tr>
                <td style="border-bottom: none">Pengikut <span style="padding-left: 200px;">Nama</span>
                <td style="border-bottom: none">Umur <span style="padding-left: 200px;">Hubungan Keluarga/Keterangan</span></td>
            </tr>
            <tr>
                <td style="border-bottom: none; border-top: none">1. </span>
            </tr>
            <tr>
                <td style="border-bottom: none; border-top: none">2. </span>
            </tr>
            <tr>
                <td style="border-bottom: none; border-top: none" class="cell-long">3. </span>
            </tr>
            <!-------------------------------------------------------------------------------->

            <tr>
                <td style="border-bottom: none">9. Pembebanan anggaran</td>
                <td style="border-bottom: none"></td>
            </tr>
            <tr>
                <td style="border-bottom: none; border-top: none"><span style="color: white">9. </span>a. Instansi</td>
                <td style="border-bottom: none; border-top: none">a. KPP Pratama Jakarta Tamansari</td>
            </tr>
            <tr>
                <td style="border-bottom: none; border-top: none"><span style="color: white">9. </span>b. Mata anggaran</td>
                <td style="border-bottom: none; border-top: none" class="lasttd">b. 5421</td>
            </tr>
            <!-------------------------------------------------------------------------------->

            <tr>
                <td>10. Keterangan lain-lain</td>
                <td class="lasttd"></td>
            </tr>
        
        </table>
        <!-------------------------------------------------------------------------------->

        <table style="border: none">
            <tr>
                <td style="border: none;">*) Coret yang tidak perlu</td>
                <td style="border: none;" class="lasttd">
                    <table style="width: 100%; border-top: none; border-right: none; border-left: none; border-bottom: 1px solid black; text-align: left; table-layout: fixed;">
                        <tr>
                            <td style="border: none; width: 10%;">Dikeluarkan di</td>
                            <td style="border: none">: Jakarta</td>
                        </tr>
                        <tr>
                            <td style="border: none;">Pada Tanggal</td>
                            <td style="border: none">: <%= new Date().toLocaleDateString("id-ID", { day: "2-digit", month: "long", year: "numeric" }) %></td>
                        </tr>
                    </table>
                </td>
            </tr>

        </table>
